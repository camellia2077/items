  "gui.command.stats.magnificence": "华丽值：{0}",
  "gui.player.stats.info.magnificence.title": "华丽值（Magnificence）",
  "gui.player.stats.info.magnificence.body": "华丽值（Magnificence）是本局隐藏属性，用来限制高品质枪械和道具的获取数量。数值越高，之后从高品质宝箱中获得高品质奖励的概率越低。",
  "gui.player.stats.info.damage.title": "伤害倍率",
  "gui.player.stats.info.damage.body": "这个数值会乘到玩家的伤害属性上。1 为正常值，更高的整数会提高伤害。",
  "gui.player.stats.info.movement.title": "移速倍率",
  "gui.player.stats.info.movement.body": "这个数值会乘到玩家的移速属性上。1 为正常值，更高的整数会提高移动速度。",
  "gui.player.stats.info.coolness.title": "酷气值（Coolness）",
  "gui.player.stats.info.coolness.body": "酷气值（Coolness）是游戏中的隐藏属性。每点酷气值可使主动道具冷却时间减少 5%，最多减少 50%，并提高战斗房间清空后获得物品奖励的概率。",
  "gui.player.stats.info.curse.title": "诅咒（Curse）",
  "gui.player.stats.info.curse.body": "Curse 是贯穿本局的风险属性。数值越高，出现 Jammed 敌人和特殊威胁的概率越高，宝箱也可能更危险，并会降低战斗房间清空后的奖励概率。Curse 不会降低主动道具冷却时间。",
  "gui.command.stats.apply": "应用",
  "gui.command.stats.clear": "清除",
  "gui.command.stats.curse": "诅咒：{0}",
  "gui.command.player.section.projectiles": "子弹",
  "gui.player.projectiles.size": "大小",
  "gui.player.projectiles.speed": "射速",
  "gui.player.projectiles.reload_speed": "换弹速度",
  "gui.player.projectiles.accuracy": "扩散程度",
  "gui.player.projectiles.info.size.title": "子弹大小",
  "gui.player.projectiles.info.size.body": "这个整数会乘到玩家的子弹大小上。允许范围是 1 到 30；1 为正常大小，更高的数值会让发射的子弹变大。",
  "gui.player.projectiles.info.speed.title": "子弹射速",
  "gui.player.projectiles.info.speed.body": "这个整数会乘到玩家的子弹速度上。允许范围是 1 到 999；1 为正常速度，更高的数值会让发射的子弹飞得更快。",
  "gui.player.projectiles.info.reload_speed.title": "换弹速度",
  "gui.player.projectiles.info.reload_speed.body": "这个小数倍率控制换弹速度。允许范围是 0.25x 到 4.0x；1.0x 为正常速度，数值越大换弹越快，数值越小换弹越慢。",
  "gui.player.projectiles.info.accuracy.title": "扩散程度",
  "gui.player.projectiles.info.accuracy.body": "这个数值控制子弹扩散程度。允许范围是 0 到 999；数值越大，扩散越大；数值为 0 则不扩散。",
  "gui.command.stats.gun_shot": "武器单发：{0}",
  "gui.command.stats.gun_reload": "武器换弹：{0}秒",
